rules_version = '2';

// ⚠ デモ用のオープンなルール（誰でも読み書き可）。
//   学生画面・スタッフ画面のどちらもクライアントから直接 orders / dailyCounters を
//   読み書きするため、デモでは全許可にしている。
//   dailyCounters は日ごとの記録の置き場: 注文番号の採番 {YYYY-MM-DD} と、売り切れ soldOut-{YYYY-MM-DD}。
//   実運用では必ず認証・権限制御（スタッフのみ status 更新可 等）を入れること。
//
// 反映方法（どちらでも可）:
//   A) Firebase コンソール → Firestore Database → ルール に、このファイルの中身を貼り付けて「公開」。
//   B) Firebase CLI でこのファイルをデプロイする:  firebase deploy --only firestore:rules
//
// 学校の Google アカウントでのログイン（VITE_LOGIN_DOMAIN）を有効にした後は、
// 注文の作成を「そのドメインでログインした人だけ」に絞れる。orders の行を次の2行に置き換える:
//   allow read, update: if true;
//   allow create: if request.auth != null && request.auth.token.email_verified == true
//                 && request.auth.token.email.matches('.*@gl[.]pen-kanagawa[.]ed[.]jp');
service cloud.firestore {
  match /databases/{database}/documents {
    match /orders/{orderId} {
      allow read, write: if true;
    }
    match /dailyCounters/{dateId} {
      allow read, write: if true;
    }
  }
}
