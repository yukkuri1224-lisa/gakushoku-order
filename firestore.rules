rules_version = '2';

// 本番用のルール（学校のアカウントでのログイン VITE_LOGIN_DOMAIN を有効にしたあとに公開する）。
//   - 学生: 学校の Google アカウント（@gl.pen-kanagawa.ed.jp、Google でログイン、メール確認済み）だけ。
//           自分の注文を作る・注文の進み具合と売り切れを見る。
//   - スタッフ: staffMembers/{UID} の記録があるアカウントだけ（Firebase コンソールで追加する）。
//           注文の状態を進める・売り切れを切り替える。
//   - それ以外（ログインしていない人、ほかのアカウント）は、何も読めず何も書けない。
//   画面側でどれだけ細工されても、データベースがこのルールで断る（画面のチェックだけに頼らない）。
//
// 合言葉のデモ（VITE_LOGIN_DOMAIN が空）のあいだは、だれでも読み書きできる firestore.demo.rules を使う。
// 学校のドメインを変えるときは、下の isStudent() のドメインも書き換える。
//
// 反映方法（どちらでも可）:
//   A) Firebase コンソール → Firestore Database → ルール に、このファイルの中身を貼り付けて「公開」。
//   B) Firebase CLI:  firebase deploy --only firestore:rules（firebase.json がこのファイルを指している）
// 確かめ方: firestore-tests/README.md（エミュレーターで、通すもの・断るものをテストする）
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // 学校の Google アカウントでログインした学生
    function isStudent() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('^[^@]+@gl[.]pen-kanagawa[.]ed[.]jp$');
    }

    // 食堂スタッフ（staffMembers/{UID} があるアカウント）
    function isStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/staffMembers/$(request.auth.uid));
    }

    function isPending(orderId) {
      return orderId.matches('pending-.+');
    }

    // スタッフの名簿。本人が「自分がスタッフか」を確かめるためだけに読める。書き込みはコンソールからだけ。
    match /staffMembers/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    match /orders/{orderId} {
      // 1件ずつ: 学生とスタッフ。PayPay の支払い中に預けた中身（pending-…）は、預けた本人だけ。
      allow get: if isStaff()
        || (isStudent() && (!isPending(orderId) || resource == null || resource.data.uid == request.auth.uid));
      // 一覧: スタッフはすべて。学生は進行中（受付済み・調理中）の注文だけ（「前に◯件」の表示用）。
      allow list: if isStaff()
        || (isStudent() && resource.data.status in ['paid', 'preparing']);

      // 学生が支払い後に作る注文（自分の UID を入れる）と、支払い前に預ける中身
      allow create: if isStudent() && (
        isPending(orderId) ? validPending(request.resource.data) : validNewOrder(request.resource.data)
      );

      // スタッフは注文の状態（と完了時刻）だけを変えられる。預けた中身は本人が置き直せる。
      allow update: if (isStaff() && !isPending(orderId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt'])
          && request.resource.data.status in ['paid', 'preparing', 'completed'])
        || (isStudent() && isPending(orderId)
          && resource.data.uid == request.auth.uid
          && validPending(request.resource.data));

      // 注文を作ったあと、預けた中身を本人が消す
      allow delete: if isStudent() && isPending(orderId) && resource.data.uid == request.auth.uid;
    }

    function validNewOrder(d) {
      return d.keys().hasOnly(['orderNumber', 'items', 'total', 'status', 'paymentMethod', 'createdAt', 'diningOption', 'uid'])
        && d.keys().hasAll(['orderNumber', 'items', 'total', 'status', 'paymentMethod', 'createdAt', 'uid'])
        && d.uid == request.auth.uid
        && d.status == 'paid'
        && d.paymentMethod in ['paypay', 'mock']
        && d.orderNumber is int && d.orderNumber > 0
        && d.total is int && d.total >= 0
        && d.createdAt is int
        && d.items is list && d.items.size() > 0 && d.items.size() <= 50
        && (!('diningOption' in d) || d.diningOption in ['eat_in', 'takeout']);
    }

    function validPending(d) {
      return d.keys().hasOnly(['status', 'draft', 'createdAt', 'uid'])
        && d.uid == request.auth.uid
        && d.status == 'awaiting_payment'
        && d.draft is map
        && d.createdAt is int;
    }

    // 日ごとの記録: 注文番号の採番 {YYYY-MM-DD} と、売り切れ soldOut-{YYYY-MM-DD}
    match /dailyCounters/{dateId} {
      allow read: if isStudent() || isStaff();

      // 売り切れはスタッフだけが切り替える
      allow write: if dateId.matches('soldOut-.+') && isStaff()
        && request.resource.data.keys().hasOnly(['items'])
        && request.resource.data.items is list;

      // 採番は、注文を作る学生が 1 ずつ進める（飛ばしたり戻したりはできない）
      allow create: if !dateId.matches('soldOut-.+') && isStudent()
        && request.resource.data.keys().hasOnly(['count', 'date'])
        && request.resource.data.count == 1
        && request.resource.data.date == dateId;
      allow update: if !dateId.matches('soldOut-.+') && isStudent()
        && request.resource.data.keys().hasOnly(['count', 'date'])
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.date == dateId;
    }
  }
}
